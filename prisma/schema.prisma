generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  WAITER
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum InventoryMovementType {
  SALE
  PURCHASE
  RETURN
  ADJUSTMENT
}

enum ProductUnit {
  PIECE
  PLATE
  GLASS
  BOTTLE
  CAN
  PORTION
  SHOT
  KG
  OTHER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model User {
  id                String              @id @default(cuid())
  firstName         String
  lastName          String
  name              String
  username          String              @unique
  email             String              @unique
  passwordHash      String
  pinHash           String?
  pinFailedAttempts Int                 @default(0)
  pinLockedUntil    DateTime?
  mustChangePin     Boolean             @default(true)
  lastLoginAt       DateTime?
  role              Role
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sales             Sale[]              @relation("CashierSales")
  movements         InventoryMovement[]
  purchases         Purchase[]
  expenses          Expense[]
  returns           Return[]
  auditLogs         AuditLog[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String              @id @default(cuid())
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  name           String
  sku            String              @unique
  seedKey        String              @unique
  description    String?
  costPrice      Decimal             @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal             @db.Decimal(12, 2)
  stockQuantity  Int                 @default(0)
  unit           ProductUnit         @default(OTHER)
  imageUrl       String?
  reorderLevel   Int                 @default(0)
  active         Boolean             @default(true)
  trackInventory Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  variants       ProductVariant[]
  saleItems      SaleItem[]
  movements      InventoryMovement[]
  purchaseItems  PurchaseItem[]
  returnItems    ReturnItem[]

  @@unique([categoryId, name])
  @@index([categoryId, active])
  @@index([name])
  @@index([trackInventory, stockQuantity])
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  sku          String      @unique
  sellingPrice Decimal     @db.Decimal(12, 2)
  unit         ProductUnit @default(PORTION)
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  saleItems    SaleItem[]

  @@unique([productId, name])
  @@index([productId, active])
}

model Sale {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  idempotencyKey  String?       @unique
  cashierId       String
  cashier       User          @relation("CashierSales", fields: [cashierId], references: [id])
  customerName  String?
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2)
  change        Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]
  payment       Payment?
  returns       Return[]

  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  saleId       String        @unique
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  cashReceived Decimal?      @db.Decimal(12, 2)
  change       Decimal?      @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
}

model SaleItem {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productName      String
  productSku       String
  variantName      String?
  unitPrice        Decimal         @db.Decimal(12, 2)
  unitCost         Decimal         @db.Decimal(12, 2)
  quantity         Int
  lineSubtotal     Decimal         @db.Decimal(12, 2)
  returnedQuantity Int             @default(0)
  createdAt        DateTime        @default(now())
  returnItems      ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([productVariantId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id])
  type          InventoryMovementType
  quantity      Int
  balanceAfter  Int
  referenceId   String?
  note          String?
  performedById String
  performedBy   User                  @relation(fields: [performedById], references: [id])
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([referenceId])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id              String         @id @default(cuid())
  referenceNumber String         @unique
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  status          PurchaseStatus @default(DRAFT)
  subtotal        Decimal        @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  note            String?
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           PurchaseItem[]

  @@index([createdAt])
  @@index([status])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  incurredAt  DateTime
  reference   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id])
  total        Decimal      @db.Decimal(12, 2)
  reason       String
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  items        ReturnItem[]
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model BusinessSettings {
  id                   String   @id @default("default")
  businessName         String   @default("B-ZENITH")
  address              String?
  phone                String?
  email                String?
  currency             String   @default("RWF")
  timezone             String   @default("Africa/Kigali")
  taxEnabled           Boolean  @default(false)
  taxRate              Decimal  @default(0) @db.Decimal(5, 2)
  receiptFooter        String   @default("Thank you for dining with us.")
  receiptSequence      Int      @default(0)
  lowStockEnabled      Boolean  @default(true)
  defaultReorderLevel  Int      @default(5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  actorUsername String?
  actorName     String?
  actorRole     Role?
  action        String
  entity        String
  entityId      String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}
