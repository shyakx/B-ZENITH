generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  WAITER
  BILLIARD
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum InventoryMovementType {
  SALE
  PURCHASE
  RETURN
  ADJUSTMENT
  STOCK_TAKE
  TRANSFER_OUT
  TRANSFER_IN
  WASTE
  SESSION_POST
  ORDER_VOID
}

enum ProductUnit {
  PIECE
  PLATE
  GLASS
  BOTTLE
  CAN
  PORTION
  SHOT
  KG
  OTHER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum ServiceChannel {
  TABLE
  WALK_IN
  COUNTER
  ACCOMMODATION
  DELIVERY
  TAKEAWAY
}

enum SessionStatus {
  ACTIVE
  SETTLING
  CLOSED
  CANCELLED
}

enum ItemStatus {
  ACTIVE
  VOIDED
  RETURNED
  EXCHANGED
}

enum AdjustmentType {
  VOID
  RETURN
  EXCHANGE
}

enum ItemCondition {
  RESELLABLE
  DAMAGED
  OPENED
  CONSUMED
  OTHER
}

enum FulfillmentStatus {
  POSTED
  PREPARING
  READY
  SERVED
}

enum CreditStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

enum StaffActionType {
  OPENED
  HANDOVER
  ROUND_POSTED
  VOID_REQUESTED
  VOID_APPROVED
  RETURN_PROCESSED
  EXCHANGE_PROCESSED
  SETTLEMENT_REQUESTED
  SETTLED
}

model User {
  id                String              @id @default(cuid())
  firstName         String
  lastName          String
  name              String
  username          String              @unique
  email             String              @unique
  passwordHash      String
  pinHash           String?
  pinFailedAttempts Int                 @default(0)
  pinLockedUntil    DateTime?
  mustChangePin     Boolean             @default(true)
  lastLoginAt       DateTime?
  role              Role
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sales             Sale[]              @relation("CashierSales")
  movements         InventoryMovement[]
  purchases         Purchase[]
  expenses          Expense[]
  returns           Return[]
  auditLogs         AuditLog[]
  billiardDaySales  BilliardDaySale[]
  stockTransfers    StockTransfer[]

  // New Hospitality Relations
  responsibleSessions   ServiceSession[]      @relation("ResponsibleWaiter")
  staffActions          SessionStaffHistory[]
  postedRounds          OrderRound[]
  requestedAdjustments  OrderAdjustment[]     @relation("AdjustmentRequester")
  approvedAdjustments   OrderAdjustment[]     @relation("AdjustmentApprover")
  receivedPayments      Payment[]             @relation("PaymentReceiver")
  approvedCredits       CreditBill[]          @relation("CreditApprover")
  receivedCreditPays    CreditPayment[]       @relation("CreditPaymentReceiver")
  fulfillmentActions    SessionItem[]         @relation("FulfillmentStaff")
  fulfillmentHistory    SessionItemFulfillmentHistory[]
  closedDays            BusinessDayClose[]    @relation("BusinessDayCloser")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String              @id @default(cuid())
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  name           String
  sku            String              @unique
  seedKey        String              @unique
  description    String?
  costPrice      Decimal             @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal             @db.Decimal(12, 2)
  stockQuantity  Int                 @default(0)
  unit           ProductUnit         @default(OTHER)
  imageUrl       String?
  reorderLevel   Int                 @default(0)
  active         Boolean             @default(true)
  trackInventory Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  variants       ProductVariant[]
  saleItems      SaleItem[]
  movements      InventoryMovement[]
  purchaseItems      PurchaseItem[]
  returnItems        ReturnItem[]
  locationStocks     ProductLocationStock[]
  transferLines      StockTransferLine[]
  sellingLocationId  String?
  sellingLocation    InventoryLocation?     @relation("ProductSellingLocation", fields: [sellingLocationId], references: [id])

  // New Hospitality Relations
  sessionItems       SessionItem[]

  @@unique([categoryId, name])
  @@index([categoryId, active])
  @@index([name])
  @@index([trackInventory, stockQuantity])
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  sku          String      @unique
  sellingPrice Decimal     @db.Decimal(12, 2)
  unit         ProductUnit @default(PORTION)
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  saleItems    SaleItem[]

  // New Hospitality Relations
  sessionItems SessionItem[]

  @@unique([productId, name])
  @@index([productId, active])
}

model Table {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, OUT_OF_SERVICE
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  ServiceSession[]
}

model ServiceSession {
  id                    String         @id @default(cuid())
  channel               ServiceChannel
  status                SessionStatus  @default(ACTIVE)
  waiterId              String
  waiter                User           @relation("ResponsibleWaiter", fields: [waiterId], references: [id])
  tableId               String?
  table                 Table?         @relation(fields: [tableId], references: [id])
  destinationLabel      String?        // Room 204, Bar Seat 3, etc.
  customerName          String?
  customerPhone         String?
  deliveryAddress       String?
  openedAt              DateTime       @default(now())
  requestedSettlementAt DateTime?
  closedAt              DateTime?
  updatedAt             DateTime       @updatedAt

  rounds                OrderRound[]
  staffHistory          SessionStaffHistory[]
  sale                  Sale?
  adjustments           OrderAdjustment[]

  @@index([status])
  @@index([waiterId])
  @@index([tableId])
}

model SessionStaffHistory {
  id           String          @id @default(cuid())
  sessionId    String
  session      ServiceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staffId      String
  staff        User            @relation(fields: [staffId], references: [id])
  action       StaffActionType
  previousStaffId String?
  note         String?
  timestamp    DateTime        @default(now())

  @@index([sessionId])
}

model OrderRound {
  id              String         @id @default(cuid())
  sessionId       String
  session         ServiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  postedById      String
  postedBy        User           @relation(fields: [postedById], references: [id])
  timestamp       DateTime       @default(now())
  idempotencyKey  String?        @unique

  items           SessionItem[]

  @@index([sessionId])
}

model SessionItem {
  id                  String            @id @default(cuid())
  roundId             String
  round               OrderRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  productVariantId    String?
  productVariant      ProductVariant?   @relation(fields: [productVariantId], references: [id])
  qty                 Int
  unitPrice           Decimal           @db.Decimal(12, 2)
  unitCost            Decimal           @db.Decimal(12, 2)
  inventoryLocationId String?
  inventoryLocation   InventoryLocation? @relation("ItemSourceLocation", fields: [inventoryLocationId], references: [id])
  status              ItemStatus        @default(ACTIVE)
  fulfillmentStatus   FulfillmentStatus @default(POSTED)
  fulfillmentStaffId  String?
  fulfillmentStaff    User?             @relation("FulfillmentStaff", fields: [fulfillmentStaffId], references: [id])
  servedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  adjustments         OrderAdjustment[] @relation("OriginalItem")
  replacements        OrderAdjustment[] @relation("ReplacementItem")
  fulfillmentHistory  SessionItemFulfillmentHistory[]

  @@index([roundId])
  @@index([productId])
}

model SessionItemFulfillmentHistory {
  id            String            @id @default(cuid())
  sessionItemId String
  sessionItem   SessionItem       @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)
  status        FulfillmentStatus
  staffId       String
  staff         User              @relation(fields: [staffId], references: [id])
  timestamp     DateTime          @default(now())

  @@index([sessionItemId])
}

model OrderAdjustment {
  id                String          @id @default(cuid())
  sessionId         String
  session           ServiceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type              AdjustmentType
  originalItemId    String
  originalItem      SessionItem     @relation("OriginalItem", fields: [originalItemId], references: [id])
  replacementItemId String?
  replacementItem   SessionItem?    @relation("ReplacementItem", fields: [replacementItemId], references: [id])
  quantity          Int
  reason            String
  condition         ItemCondition?
  requestedById     String
  requestedBy       User            @relation("AdjustmentRequester", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?           @relation("AdjustmentApprover", fields: [approvedById], references: [id])
  createdAt         DateTime        @default(now())

  @@index([sessionId])
  @@index([originalItemId])
}

model Sale {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  idempotencyKey  String?       @unique
  cashierId       String
  cashier       User          @relation("CashierSales", fields: [cashierId], references: [id])
  sessionId     String?       @unique
  session       ServiceSession? @relation(fields: [sessionId], references: [id])
  customerName  String?
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2) // Total of all successful payments
  change        Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]
  payments      Payment[]     @relation("SalePayments")
  returns       Return[]
  creditBill    CreditBill?

  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  saleId       String
  sale         Sale          @relation("SalePayments", fields: [saleId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  cashReceived Decimal?      @db.Decimal(12, 2)
  change       Decimal?      @db.Decimal(12, 2)
  receivedById String?
  receivedBy   User?         @relation("PaymentReceiver", fields: [receivedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([saleId])
}

model CreditBill {
  id            String        @id @default(cuid())
  saleId        String        @unique
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sessionId     String?
  customerName  String
  customerPhone String?
  total         Decimal       @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        CreditStatus  @default(OUTSTANDING)
  approvedById  String?
  approvedBy    User?         @relation("CreditApprover", fields: [approvedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments      CreditPayment[]

  @@index([status])
}

model CreditPayment {
  id           String      @id @default(cuid())
  creditBillId String
  creditBill   CreditBill  @relation(fields: [creditBillId], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(12, 2)
  method       PaymentMethod
  receivedById String
  receivedBy   User        @relation("CreditPaymentReceiver", fields: [receivedById], references: [id])
  timestamp    DateTime    @default(now())

  @@index([creditBillId])
}

model SaleItem {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productName      String
  productSku       String
  variantName      String?
  unitPrice        Decimal         @db.Decimal(12, 2)
  unitCost         Decimal         @db.Decimal(12, 2)
  quantity         Int
  lineSubtotal     Decimal         @db.Decimal(12, 2)
  returnedQuantity    Int                @default(0)
  inventoryLocationId String?
  inventoryLocation   InventoryLocation? @relation(fields: [inventoryLocationId], references: [id])
  createdAt           DateTime           @default(now())
  returnItems         ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([productVariantId])
}

model InventoryLocation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks              ProductLocationStock[]
  sellingProducts     Product[]              @relation("ProductSellingLocation")
  saleItems           SaleItem[]
  movements           InventoryMovement[]    @relation("MovementLocation")
  counterpartMoves    InventoryMovement[]    @relation("MovementCounterpart")
  transfersOut        StockTransfer[]        @relation("TransferFrom")
  transfersIn         StockTransfer[]        @relation("TransferTo")

  // New Hospitality Relations
  sessionItems        SessionItem[]          @relation("ItemSourceLocation")
}

model ProductLocationStock {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id])
  quantity   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
}

model StockTransfer {
  id             String            @id @default(cuid())
  fromLocationId String
  fromLocation   InventoryLocation @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     InventoryLocation @relation("TransferTo", fields: [toLocationId], references: [id])
  recordedById   String
  recordedBy     User              @relation(fields: [recordedById], references: [id])
  note           String?
  createdAt      DateTime          @default(now())
  lines          StockTransferLine[]

  @@index([createdAt])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([transferId])
}

model InventoryMovement {
  id                     String                 @id @default(cuid())
  productId              String
  product                Product                @relation(fields: [productId], references: [id])
  type                   InventoryMovementType
  quantity               Int
  balanceAfter           Int
  referenceId            String?
  reason                 String?
  note                   String?
  performedById          String
  performedBy            User                   @relation(fields: [performedById], references: [id])
  locationId             String?
  location               InventoryLocation?     @relation("MovementLocation", fields: [locationId], references: [id])
  counterpartLocationId  String?
  counterpartLocation    InventoryLocation?     @relation("MovementCounterpart", fields: [counterpartLocationId], references: [id])
  createdAt              DateTime               @default(now())

  @@index([productId, createdAt])
  @@index([referenceId])
  @@index([locationId, createdAt])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id              String         @id @default(cuid())
  referenceNumber String         @unique
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  status          PurchaseStatus @default(DRAFT)
  subtotal        Decimal        @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  note            String?
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           PurchaseItem[]

  @@index([createdAt])
  @@index([status])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  incurredAt  DateTime
  reference   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id])
  total        Decimal      @db.Decimal(12, 2)
  reason       String
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  items        ReturnItem[]
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model BilliardDaySale {
  id          String   @id @default(cuid())
  businessDay String
  operatorId  String
  operator    User     @relation(fields: [operatorId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessDay, operatorId])
  @@index([businessDay])
}

model BusinessSettings {
  id                   String   @id @default("default")
  businessName         String   @default("B-ZENITH")
  address              String?
  phone                String?
  email                String?
  currency             String   @default("RWF")
  timezone             String   @default("Africa/Kigali")
  taxEnabled           Boolean  @default(false)
  taxRate              Decimal  @default(0) @db.Decimal(5, 2)
  receiptFooter        String   @default("Thank you for dining with us.")
  receiptSequence      Int      @default(0)
  lowStockEnabled      Boolean  @default(true)
  defaultReorderLevel  Int      @default(5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BusinessDayClose {
  id            String   @id @default(cuid())
  businessDay   String   @unique
  closedAt      DateTime @default(now())
  closedById    String
  closedBy      User     @relation("BusinessDayCloser", fields: [closedById], references: [id])
  posCount      Int
  posGross      Decimal  @db.Decimal(12, 2)
  posNet        Decimal  @db.Decimal(12, 2)
  billiardTotal Decimal  @db.Decimal(12, 2)
  expenseTotal  Decimal  @db.Decimal(12, 2)
  note          String?

  @@index([closedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  actorUsername String?
  actorName     String?
  actorRole     Role?
  action        String
  entity        String
  entityId      String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}
