DATABASE_URL="postgresql://bzenith:bzenith@localhost:5432/bzenith"
# Neon production: Prisma transfers/POS use interactive transactions.
# Set DIRECT_URL to the non-pooler host (ep-xxx.region.aws.neon.tech),
# or leave it unset — the app rewrites *-pooler.* to the compute endpoint.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
SESSION_SECRET="change-this-to-a-long-random-string-32+"

# Production setup (prisma/production-setup.ts) — optional, never commit real values.
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_PIN=
# INITIAL_ORDER_SEQUENCE_START=1000

# Production catalog import (prisma/production-catalog-import.ts)
# Never point this at the old Vercel production database.
# PRODUCTION_CATALOG_DRY_RUN=YES
# PRODUCTION_CATALOG_IMPORT_CONFIRM=YES
