# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bzenith?schema=public"

# Public app URL
NEXTAUTH_URL="http://localhost:3000"

# Required in production (NODE_ENV=production): 32+ random characters.
# Do not use this placeholder, and do not use BZenith@2026.
# Do not commit a real secret.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Used only by prisma/seed.ts for local staff accounts. Not used by the running app.
SEED_USER_PASSWORD="BZenith@2026"

# Example staff (owner@example.com / BZenith@2026) are never created when
# NODE_ENV=production or DATABASE_URL is not localhost.
# SEED_DEV_USERS="true"
