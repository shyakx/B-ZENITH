# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL — B-ZENITH uses Docker mapped to host port 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bzenith?schema=public"

# Public app URL
NEXTAUTH_URL="http://localhost:3000"

# Required in production: a long random secret (32+ characters).
# Do not use this placeholder outside local development.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Used only by prisma/seed.ts for local staff accounts. Not used by the UI.
SEED_USER_PASSWORD="BZenith@2026"

# Production seed never creates example staff unless this is true.
# SEED_DEV_USERS="true"
